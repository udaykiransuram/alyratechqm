{
  "name": "school-quality-management-workspace",
  "version": "1.0.0",
  "type": "module",
  "description": "School quality management workspace built with Next.js",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "BROWSERSLIST_IGNORE_OLD_DATA=1 next build",
    "start": "next start",
    "mcp:stitch": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/stitch-mcp-server.mjs",
    "lint": "eslint app components hooks lib local-tests models scripts tests types utils middleware.ts next.config.mjs postcss.config.cjs tailwind.config.ts playwright.online-integration.config.ts global.d.ts --no-error-on-unmatched-pattern",
    "lint:online-test": "eslint app/api/student/tests/route.ts app/api/student/tests/[paperId]/route.ts app/api/student/tests/[paperId]/attempt/route.ts app/api/student/tests/[paperId]/submit/route.ts app/api/student/session/heartbeat/route.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify:core": "npm run lint && npm run typecheck && npm run build",
    "verify:integration": "node scripts/verify-online-integration.mjs",
    "verify:release": "node scripts/verify-release-health.mjs",
    "verify:full": "npm run verify:release && npm run test:e2e && npm run verify:integration",
    "verify:ci": "npm run verify:full",
    "verify:student-tests:preflight": "npm run preflight:online-test",
    "verify:extended": "npm run verify:full && npm run verify:student-tests:preflight",
    "backfill:exam-runtime-snapshots": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/backfill-exam-runtime-snapshots.ts",
    "backfill:question-paper-subjects": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/backfill-question-paper-subject-ids.ts",
    "repair:student-login": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/repair-student-login.ts",
    "reset:student-passwords-to-phone": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/reset-student-passwords-to-roll-numbers.ts",
    "reset:student-passwords-to-roll": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/reset-student-passwords-to-roll-numbers.ts",
    "check:redis": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm scripts/check-redis.ts",
    "build-indexes": "ts-node scripts/build-indexes.ts",
    "build-tenant-indexes": "ts-node scripts/build-tenant-indexes.ts",
    "predev": "node scripts/build-tenant-indexes.cjs || echo \"[predev] Skipping index build (DB unreachable)\"",
    "test:e2e": "playwright test -c local-tests/playwright.config.ts",
    "test:e2e:list": "PLAYWRIGHT_USE_EXTERNAL_SERVER=1 playwright test -c local-tests/playwright.config.ts --list",
    "test:e2e:desktop": "playwright test -c local-tests/playwright.config.ts --project=chromium-desktop",
    "test:e2e:mobile": "playwright test -c local-tests/playwright.config.ts --project=chromium-mobile",
    "test:e2e:student-tests:ui": "playwright test -c local-tests/playwright.config.ts local-tests/tests/e2e/student-tests-ui.spec.ts local-tests/tests/e2e/student-tests-resilience-ui.spec.ts --project=chromium-desktop",
    "test:e2e:learning-content": "playwright test -c local-tests/playwright.config.ts local-tests/tests/e2e/learning-content.spec.ts --project=chromium-desktop",
    "test:e2e:learning-content:external": "PLAYWRIGHT_USE_EXTERNAL_SERVER=1 playwright test -c local-tests/playwright.config.ts local-tests/tests/e2e/learning-content.spec.ts --project=chromium-desktop",
    "test:e2e:learning-content:integration": "EXAM_RUNTIME_DATABASE_URL= PLAYWRIGHT_USE_EXTERNAL_SERVER=1 playwright test -c playwright.online-integration.config.ts tests/e2e/learning-content-integration.spec.ts --project=chromium-desktop --workers=1",
    "test:e2e:learning-content:runtime": "PLAYWRIGHT_USE_EXTERNAL_SERVER=1 playwright test -c playwright.online-integration.config.ts tests/e2e/learning-content-runtime.spec.ts --project=chromium-desktop --workers=1",
    "test:e2e:report": "playwright show-report",
    "test:e2e:smoke": "playwright test -c local-tests/playwright.config.ts local-tests/tests/e2e/auth-smoke.spec.ts local-tests/tests/e2e/release-health.spec.ts local-tests/tests/e2e/workspace-smoke.spec.ts --project=chromium-desktop",
    "test:e2e:smoke:external": "PLAYWRIGHT_USE_EXTERNAL_SERVER=1 playwright test -c local-tests/playwright.config.ts local-tests/tests/e2e/auth-smoke.spec.ts local-tests/tests/e2e/release-health.spec.ts local-tests/tests/e2e/workspace-smoke.spec.ts --project=chromium-desktop",
    "test:e2e:online-integration": "playwright test -c playwright.online-integration.config.ts tests/e2e/student-tests-integration.spec.ts --project=chromium-desktop --workers=1",
    "test:e2e:headed": "playwright test -c local-tests/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test -c local-tests/playwright.config.ts --ui",
    "stress:student-tests": "node scripts/stress-student-exam.mjs",
    "stress:student-tests:browser": "node scripts/stress-student-exam-browser.mjs",
    "stress:learning-content": "node scripts/stress-learning-content.mjs",
    "stress:online-test": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/run-online-test-stress.ts",
    "stress:online-test:smoke": "npm run stress:online-test -- --profile=smoke",
    "stress:online-test:100": "npm run stress:online-test -- --base=http://localhost:3000 --server-mode=external --auto-seed=true --cleanup-seeded=true --seed-students=100 --concurrency=100 --rounds=3",
    "stress:online-test:1k": "npm run stress:online-test -- --config=scripts/load-configs/online-test-scale-1k.json",
    "stress:online-test:5k": "npm run stress:online-test -- --config=scripts/load-configs/online-test-scale-5k.json",
    "stress:online-test:10k": "npm run stress:online-test -- --config=scripts/load-configs/online-test-scale-10k.json",
    "stress:online-test:browser": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/run-online-test-browser-stress.ts",
    "stress:online-test:browser:100": "npm run stress:online-test:browser -- --auto-seed=true --cleanup-seeded=true --seed-students=100 --concurrency=100 --rounds=3",
    "gate:student-tests:seed": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/seed-student-exam-readiness.ts",
    "gate:student-tests:cleanup": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/cleanup-student-exam-readiness.ts",
    "gate:student-tests:load": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/run-student-exam-load-gate.ts",
    "gate:learning-content:seed": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/seed-learning-content-readiness.ts",
    "gate:learning-content:cleanup": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/cleanup-learning-content-readiness.ts",
    "gate:learning-content:load": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/run-learning-content-load-gate.ts",
    "gate:student-tests:browser": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/run-student-exam-browser-load-gate.ts",
    "preflight:online-test": "TS_NODE_TRANSPILE_ONLY=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local --loader ts-node/esm --loader ./scripts/alias-loader.mjs scripts/run-online-test-preflight.ts",
    "verify:learning-content": "npm run test:e2e:learning-content",
    "test:seed": "ts-node scripts/seed-test-data.ts",
    "migrate:class-sections": "ts-node --esm scripts/migrate-class-sections.ts",
    "smoke:upload-benchmark": "node scripts/smoke-upload-benchmark.mjs"
  },
  "keywords": [
    "nextjs",
    "react",
    "tailwind",
    "school-quality",
    "assessment-operations"
  ],
  "author": "Your Name Here",
  "license": "ISC",
