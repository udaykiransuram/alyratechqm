MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/school-quality?retryWrites=true&w=majority
# Canonical site URL used for auth callbacks and other absolute URLs.
NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=replace_with_a_long_random_secret
# Optional backward-compatible public site URL. You can omit this and rely on NEXTAUTH_URL.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
GOOGLE_SITE_VERIFICATION=your-search-console-verification-token
ENABLE_PRODUCTION_ADMIN_MAINTENANCE=false
ENABLE_PRODUCTION_DEBUG_ROUTES=false

# Company admin bootstrap
COMPANY_ADMIN_BOOTSTRAP_NAME=Platform Administrator
COMPANY_ADMIN_BOOTSTRAP_EMAIL=admin@yourcompany.com
COMPANY_ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_secure_password

# WhatsApp Meta Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_FALLBACK_TEMPLATE_NAME=hello_world
WHATSAPP_FALLBACK_TEMPLATE_LANG=en_US

# Report dispatch worker
# Supported values: document, template_first, template_only
REPORT_DISPATCH_DELIVERY_MODE=document
REPORT_DISPATCH_STALE_MINUTES=15
REPORT_DISPATCH_PROVIDER_ACK_WAIT_MINUTES=45
REPORT_DISPATCH_WORKER_SECRET=replace_with_a_long_random_secret
