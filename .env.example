# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/school-quality?retryWrites=true&w=majority
# Production pool tuning. These match the app's serverless-safe defaults.
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=30000

# Canonical site URL used for auth callbacks and other absolute URLs.
NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=replace_with_a_long_random_secret
# Optional backward-compatible public site URL. You can omit this and rely on NEXTAUTH_URL.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
GOOGLE_SITE_VERIFICATION=your-search-console-verification-token
ENABLE_PRODUCTION_ADMIN_MAINTENANCE=false
ENABLE_PRODUCTION_DEBUG_ROUTES=false

# Cashfree production payments
# Use live Cashfree credentials when CASHFREE_ENV/NEXT_PUBLIC_CASHFREE_ENV are production.
CASHFREE_ENV=production
NEXT_PUBLIC_CASHFREE_ENV=production
CASHFREE_BASE_URL=https://api.cashfree.com
CASHFREE_APP_ID=your_cashfree_live_app_id
CASHFREE_SECRET_KEY=your_cashfree_live_secret_key
CASHFREE_WEBHOOK_SECRET=replace_with_cashfree_webhook_secret

# Summer Crash campaign
SUMMER_CRASH_SCHOOL_KEY=summer-crash-course
SUMMER_CRASH_DISPLAY_NAME=Math Foundations Summer Sprint
SUMMER_CRASH_SUPPORT_CONTACT=+919999999999
SUMMER_CRASH_PRICE=499
SUMMER_CRASH_CURRENCY=INR
SUMMER_CRASH_EARLY_BIRD_PRICE=299
SUMMER_CRASH_EARLY_BIRD_ENDS_AT=2026-05-05T23:59:59+05:30
SUMMER_CRASH_EARLY_BIRD_LABEL=Early Bird Offer
SUMMER_CRASH_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your-invite-code

# Upstash Redis
# Required in production for rate limits, locks, and background Redis queues.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
LIVE_SESSION_PRESENCE_CACHE_TTL_SECONDS=90

# Neon Postgres
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/dbname?sslmode=require
EXAM_RUNTIME_DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/exam_runtime?sslmode=require
EXAM_RUNTIME_POOL_MAX=20
EXAM_RUNTIME_SNAPSHOT_CACHE_TTL_MS=120000
STUDENT_SESSION_TTL_SECONDS=180
ATTEMPT_LOCK_TTL_SECONDS=120
SNAPSHOT_CACHE_TTL_SECONDS=300
AUTOSAVE_RATE_WINDOW_SECONDS=30

# Company admin bootstrap
COMPANY_ADMIN_BOOTSTRAP_NAME=Platform Administrator
COMPANY_ADMIN_BOOTSTRAP_EMAIL=admin@yourcompany.com
COMPANY_ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_secure_password

# WhatsApp Meta Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_FALLBACK_TEMPLATE_NAME=hello_world
WHATSAPP_FALLBACK_TEMPLATE_LANG=en_US

# Report dispatch worker
# Supported values: document, template_first, template_only
REPORT_DISPATCH_DELIVERY_MODE=document
REPORT_DISPATCH_STALE_MINUTES=15
REPORT_DISPATCH_PROVIDER_ACK_WAIT_MINUTES=45
REPORT_DISPATCH_WORKER_SECRET=replace_with_a_long_random_secret
STUDENT_NOTIFICATION_WORKER_SECRET=replace_with_a_long_random_secret
PARENT_UPDATES_WORKER_SECRET=replace_with_a_long_random_secret
EXAM_RUNTIME_PROJECTION_WORKER_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_long_random_secret

# Trusted internal origin for server-to-server report fetches.
# In production this should match your canonical app origin.
INTERNAL_API_BASE_URL=https://your-production-domain.com

# Registration/payment security
# Optional extra secret for public registration scope + success-link tokens.
# If omitted, NEXTAUTH_SECRET is used instead.
REGISTRATION_SECURITY_SECRET=replace_with_a_long_random_secret

# Local PDF extraction worker for authenticated parse uploads
PDF_EXTRACT_SERVICE_URL=http://localhost:5000/extract
